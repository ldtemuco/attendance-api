+import { describe, expect, it } from "vitest";
+import
+{
+    areValidPeriodDates,
+    getMonthBounds,
+    isPositiveInteger,
+    isValidIsoDate
+}
+from "../src/services/attendance-period-validation";
+
+describe("Attendance period validation", () =>
+{
+    it("calculates February limits in a leap year", () =>
+    {
+        expect(getMonthBounds(2028, 2)).toEqual
+        ({
+            dateStart: "2028-02-01",
+            dateEnd: "2028-02-29"
+        });
+    });
+
+    it("calculates the non-leap February and December", () =>
+    {
+        expect(getMonthBounds(2026, 2).dateEnd).toBe("2026-02-28");
+        expect(getMonthBounds(2026, 12).dateEnd).toBe("2026-12-31");
+    });
+
+    it("rejects invalid calendar dates", () =>
+    {
+        expect(isValidIsoDate("2026-02-29")).toBe(false);
+        expect(isValidIsoDate("2026-13-01")).toBe(false);
+        expect(isValidIsoDate("2026-10-12")).toBe(true);
+    });
+
+    it("does not accept decimals or numeric strings as ids", () =>
+    {
+        expect(isPositiveInteger(2)).toBe(true);
+        expect(isPositiveInteger("2")).toBe(false);
+        expect(isPositiveInteger(1.2)).toBe(false);
+    });
+
+    it("rejects dates in another month or another year", () =>
+    {
+        expect(areValidPeriodDates(2026, 10, "2026-10-01", "2026-11-01")).toBe(false);
+        expect(areValidPeriodDates(2026, 10, "2025-10-01", "2025-10-31")).toBe(false);
+    });
+
+    it("rejects inverted dates and accepts valid shortened periods", () =>
+    {
+        expect(areValidPeriodDates(2026, 10, "2026-10-25", "2026-10-10")).toBe(false);
+        expect(areValidPeriodDates(2026, 10, "2026-10-05", "2026-10-30")).toBe(true);
+    });
+});
